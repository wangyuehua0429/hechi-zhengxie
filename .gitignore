# 系统与编辑器
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~
*.sublime-project
*.sublime-workspace

# PHP（主站 CMS）
/vendor/
composer.phar
*.cache
.phpunit.result.cache
.phpunit.cache
backend/storage/*
!backend/storage/.gitignore

# Python（智能编校微服务）
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node（前端构建产物，若启用）
/node_modules/

# 环境变量与密钥
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.ppk
id_rsa*

# 运行时与数据
*.log
*.dump
*.sql.gz
backend/public/uploads/
backend/storage/uploads/

# 本地工具与调试产物
# tools/migrate/out/ 是迁移脚本的中间产物（媒体清单、核对报告等），不入库
tools/migrate/out/
# 换数据源重跑时上一版产物留在 out-<日期>/ 作对拍基线，同样不入库
tools/migrate/out-*/
# .claude/ 与 .playwright-mcp/ 为 Claude Code、Playwright MCP 的会话与快照文件；
# /*.png 只忽略仓库根目录的调试截图，站内图片在 frontend/home/images/ 下不受影响
.claude/
.playwright-mcp/
/*.png
# Added by code-review-graph
.code-review-graph/
