# 运行环境（复制为 .env 后按需修改；backend/config/config.php 读取这些变量）
APP_ENV=local
APP_DEBUG=1

# 站点
SITE_ID=1
SITE_CODE=main
SITE_NAME=广西河池政协网
SITE_DOMAIN=www.gxhczx.gov.cn

# 数据库：本地默认 sqlite（backend/storage/hechi_zx.sqlite），生产用 mysql
DB_DRIVER=sqlite
DB_DATABASE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=hechi_zx
DB_PASSWORD=

# 静态化输出目录（默认 backend/storage/publish）
PUBLISH_OUT=
